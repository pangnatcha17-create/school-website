<script>
const STORAGE_KEY = "panyathara_website_news_v1";

const sampleNews = [
  {
    id: "n1",
    title: "ยินดีต้อนรับสู่เว็บไซต์โรงเรียน",
    detail: "ติดตามข่าวสารและประกาศสำคัญของโรงเรียนได้ที่นี่",
    date: "21/10/2569"
  },
  {
    id: "n2",
    title: "กิจกรรมส่งเสริมการเรียนรู้",
    detail: "สนับสนุนการเรียนรู้ทั้งในและนอกห้องเรียน",
    date: "20/10/2569"
  },
  {
    id: "n3",
    title: "เทคโนโลยีเพื่อการศึกษา",
    detail: "ส่งเสริมทักษะดิจิทัลและการเรียนรู้อย่างสร้างสรรค์",
    date: "19/10/2569"
  }
];

function loadNews() {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved === null) return sampleNews.map(x => ({...x}));
    const parsed = JSON.parse(saved);
    return Array.isArray(parsed) ? parsed : sampleNews.map(x => ({...x}));
  } catch {
    return sampleNews.map(x => ({...x}));
  }
}

let news = loadNews();

function saveNews() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(news));
    return true;
  } catch {
    alert("ไม่สามารถบันทึกข้อมูลได้");
    return false;
  }
}

function element(tag, className, value) {
  const node = document.createElement(tag);
  if (className) node.className = className;
  if (value !== undefined) node.textContent = value;
  return node;
}

function renderNews() {
  const grid = document.getElementById("newsGrid");
  const query = document.getElementById("searchNews")
    .value.toLowerCase().trim();

  grid.replaceChildren();

  const filtered = news.filter(item =>
    item.title.toLowerCase().includes(query) ||
    item.detail.toLowerCase().includes(query)
  );

  if (!filtered.length) {
    grid.appendChild(element("p", "", "ไม่พบข่าวประชาสัมพันธ์"));
  }

  filtered.forEach((item, index) => {
    const card = element("article", "card");
    const image = element(
      "div", "card-image", ["📢", "📚", "💡"][index % 3]
    );
    const body = element("div", "card-body");

    body.append(
      element("span", "tag", "ประชาสัมพันธ์"),
      element("h3", "", item.title),
      element("p", "", item.detail),
      element("small", "date", item.date)
    );

    card.append(image, body);
    grid.appendChild(card);
  });
}

function renderAdmin() {
  const list = document.getElementById("adminList");
  list.replaceChildren();

  news.forEach(item => {
    const row = element("div", "admin-row");
    const title = element("strong", "", item.title);
    const actions = element("div", "admin-actions");

    const edit = element("button", "btn btn-gray", "แก้ไข");
    const remove = element("button", "btn btn-red", "ลบ");

    edit.type = "button";
    remove.type = "button";

    edit.addEventListener("click", () => editNews(item.id));
    remove.addEventListener("click", () => deleteNews(item.id));

    actions.append(edit, remove);
    row.append(title, actions);
    list.appendChild(row);
  });
}

function editNews(id) {
  const item = news.find(n => n.id === id);
  if (!item) return;

  const title = prompt("แก้ไขหัวข้อข่าว", item.title);
  if (title === null) return;

  const detail = prompt("แก้ไขรายละเอียดข่าว", item.detail);
  if (detail === null) return;

  if (!title.trim() || !detail.trim()) {
    alert("กรุณากรอกข้อมูลให้ครบ");
    return;
  }

  item.title = title.trim().slice(0, 120);
  item.detail = detail.trim().slice(0, 3000);

  if (saveNews()) {
    renderNews();
    renderAdmin();
  }
}

function deleteNews(id) {
  if (!confirm("คุณต้องการลบข่าวนี้ใช่หรือไม่?")) return;

  news = news.filter(item => item.id !== id);

  if (saveNews()) {
    renderNews();
    renderAdmin();
  }
}

document.getElementById("newsForm")
  .addEventListener("submit", function(event) {
    event.preventDefault();

    const title = document.getElementById("newsTitle").value.trim();
    const detail = document.getElementById("newsDetail").value.trim();

    if (!title || !detail) return;

    news.unshift({
      id: String(Date.now()) + Math.random().toString(36).slice(2),
      title,
      detail,
      date: new Date().toLocaleDateString("th-TH")
    });

    if (saveNews()) {
      this.reset();
      renderNews();
      renderAdmin();
      alert("เพิ่มข่าวสำเร็จในเบราว์เซอร์นี้");
    }
  });

document.getElementById("searchNews")
  .addEventListener("input", renderNews);

document.getElementById("exportBtn")
  .addEventListener("click", function() {
    const blob = new Blob(
      [JSON.stringify(news, null, 2)],
      {type: "application/json"}
    );

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = "school-news-backup.json";

    document.body.appendChild(link);
    link.click();
    link.remove();

    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });

renderNews();
renderAdmin();
</script>
</body>
</html>
