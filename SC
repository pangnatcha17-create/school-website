  <p>เรียนรู้อย่างสร้างสรรค์ ก้าวทันโลกอนาคต</p>
  <small>© <span id="year"></span> เว็บไซต์ตัวอย่างเพื่อการศึกษา</small>
</footer>

<script>
"use strict";

// ไม่อ่านหรือบันทึก localStorage ของเว็บไซต์เก่า
const seed = {
  news: [
    {
      id: "n1",
      title: "ยินดีต้อนรับสู่เว็บไซต์โรงเรียนตัวอย่างวิทยา",
      date: "2026-10-21",
      detail: "ศูนย์รวมข่าวสารและประกาศของโรงเรียนตัวอย่างวิทยา"
    },
    {
      id: "n2",
      title: "เปิดพื้นที่การเรียนรู้อย่างสร้างสรรค์",
      date: "2026-10-20",
      detail: "ส่งเสริมการเรียนรู้และการพัฒนาทักษะที่หลากหลายของนักเรียน"
    },
    {
      id: "n3",
      title: "ประชาสัมพันธ์ช่องทางติดต่อโรงเรียน",
      date: "2026-10-19",
      detail: "ติดตามข้อมูลประชาสัมพันธ์และช่องทางติดต่อได้ทางเว็บไซต์นี้"
    }
  ],
  events: [
    {
      id: "e1",
      title: "สัปดาห์รักการอ่าน",
      date: "2026-11-05",
      detail: "กิจกรรมส่งเสริมการอ่านและแลกเปลี่ยนหนังสือ"
    },
    {
      id: "e2",
      title: "วันวิทยาศาสตร์สร้างสรรค์",
      date: "2026-11-12",
      detail: "ทดลองและเรียนรู้ผ่านกิจกรรมวิทยาศาสตร์"
    },
    {
      id: "e3",
      title: "จิตอาสาพัฒนาโรงเรียน",
      date: "2026-11-20",
      detail: "ร่วมกันดูแลพื้นที่และสิ่งแวดล้อมของโรงเรียน"
    }
  ]
};

const clone = value => JSON.parse(JSON.stringify(value));
const $ = id => document.getElementById(id);

let data = clone(seed);
let mode = "news";
let editing = null;

function node(tag, className, value) {
  const element = document.createElement(tag);
  if (className) element.className = className;
  if (value !== undefined) element.textContent = value;
  return element;
}

function formatDate(value) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return value;
  const [year, month, day] = value.split("-");
  return `${day}/${month}/${Number(year) + 543}`;
}

function makeCard(item, emoji) {
  const card = node("article", "card");
  const art = node("div", "art", emoji);
  const body = node("div", "card-body");

  body.append(
    node("span", "pill", formatDate(item.date)),
    node("h3", "", item.title),
    node("p", "", item.detail)
  );

  card.append(art, body);
  return card;
}

function render() {
  const query = $("search").value.toLowerCase().trim();

  const filtered = data.news.filter(item =>
    (item.title + " " + item.detail).toLowerCase().includes(query)
  );

  $("newsGrid").replaceChildren(
    ...filtered.map(item => makeCard(item, "📣"))
  );

  if (!filtered.length) {
    $("newsGrid").append(
      node("p", "empty", "ไม่พบข่าวที่ค้นหา")
    );
  }

  $("eventsGrid").replaceChildren(
    ...data.events.map(item => makeCard(item, "🎉"))
  );

  const list = $("adminList");
  list.replaceChildren();

  data[mode].forEach(item => {
    const row = node("div", "admin-row");
    const left = node("div");
    const actions = node("div", "actions");

    const edit = node("button", "btn secondary small", "แก้ไข");
    const remove = node("button", "btn danger small", "ลบ");

    left.append(
      node("strong", "", item.title),
      node("div", "muted", formatDate(item.date))
    );

    edit.type = "button";
    remove.type = "button";

    edit.onclick = () => {
      editing = item.id;
      $("title").value = item.title;
      $("date").value = item.date;
      $("detail").value = item.detail;
      $("editorHeading").textContent = "แก้ไขข้อมูล";
    };

    remove.onclick = () => {
      if (confirm("ต้องการลบรายการนี้ใช่หรือไม่?")) {
        data[mode] = data[mode].filter(x => x.id !== item.id);
        clearForm();
        render();
      }
    };

    actions.append(edit, remove);
    row.append(left, actions);
    list.append(row);
  });

  if (!data[mode].length) {
    list.append(node("p", "empty", "ยังไม่มีรายการ"));
  }
}

function clearForm() {
  editing = null;
  $("editor").reset();
  $("date").value = new Date().toLocaleDateString("en-CA");
  $("editorHeading").textContent =
    mode === "news" ? "เพิ่มข่าวสาร" : "เพิ่มกิจกรรม";
}

function switchMode(next) {
  mode = next;
  clearForm();
  render();

  $("newsTab").className =
    "btn small" + (mode === "news" ? "" : " secondary");

  $("eventsTab").className =
    "btn small" + (mode === "events" ? "" : " secondary");
}

$("search").addEventListener("input", render);

$("newsTab").onclick = () => switchMode("news");
$("eventsTab").onclick = () => switchMode("events");
$("cancel").onclick = clearForm;

$("reset").onclick = () => {
  if (confirm("คืนค่าข้อมูลตัวอย่างทั้งหมดใช่หรือไม่?")) {
    data = clone(seed);
    clearForm();
    render();
  }
};

$("editor").onsubmit = event => {
  event.preventDefault();

  const title = $("title").value.trim();
  const date = $("date").value;
  const detail = $("detail").value.trim();

  if (!title || !date || !detail) return;

  const item = {
    id: editing || ("id" + Date.now() + Math.random()),
    title,
    date,
    detail
  };

  if (editing) {
    data[mode] = data[mode].map(x =>
      x.id === editing ? item : x
    );
  } else {
    data[mode].unshift(item);
  }

  clearForm();
  render();
  alert("บันทึกข้อมูลสาธิตเรียบร้อยแล้ว");
};

$("year").textContent = new Date().getFullYear();

clearForm();
render();
</script>
</body>
</html>
