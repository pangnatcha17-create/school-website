
<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>โรงเรียนปัญญาธาราวิทยา | เว็บไซต์ประชาสัมพันธ์</title>
<style>
:root{
  --navy:#143361;
  --blue:#2159a5;
  --teal:#16b8a9;
  --pale:#eef5ff;
  --text:#243956;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  font-family:Thonburi,"Noto Sans Thai",sans-serif;
  color:var(--text);
  background:#f6f9fe;
}
a{text-decoration:none;color:inherit}
button,input,textarea{font:inherit}
button{cursor:pointer}
.container{max-width:1180px;margin:auto;padding:0 24px}
header{
  background:white;
  position:sticky;
  top:0;
  z-index:20;
  box-shadow:0 3px 15px #17365d13;
}
.navbar{
  min-height:80px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:18px;
  flex-wrap:wrap;
}
.brand{
  display:flex;
  align-items:center;
  gap:14px;
  font-size:19px;
  font-weight:800;
  color:var(--navy);
}
.logo{
  width:53px;height:53px;
  display:grid;place-items:center;
  background:#e8f1ff;
  border-radius:17px;
  font-size:29px;
}
.brand small{
  display:block;
  font-size:11px;
  color:#8495ad;
  font-weight:500;
}
nav{display:flex;gap:18px;flex-wrap:wrap}
nav a{font-size:13px;font-weight:700}
nav a:hover{color:var(--blue)}
.hero{
  background:linear-gradient(115deg,#123361 0%,#205eaa 65%,#16b8a9 100%);
  color:white;
  padding:68px 0 90px;
}
.hero-grid{
  display:grid;
  grid-template-columns:1.3fr 1fr;
  align-items:center;
  gap:42px;
}
.eyebrow{
  color:#aeeef5;
  letter-spacing:2px;
  font-size:14px;
  font-weight:800;
}
.hero h1{
  font-size:clamp(32px,4.4vw,54px);
  line-height:1.35;
  margin:18px 0;
}
.hero p{
  color:#e3f1ff;
  font-size:16px;
  line-height:2;
  max-width:650px;
}
.hero-art{
  min-height:280px;
  background:#ffffff1c;
  border:1px solid #ffffff50;
  border-radius:30px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  gap:14px;
  font-size:90px;
}
.hero-art span{font-size:17px;font-weight:700}
.btn{
  display:inline-block;
  border:0;
  border-radius:12px;
  padding:12px 21px;
  background:var(--blue);
  color:white;
  font-weight:700;
}
.btn:hover{opacity:.9}
.btn-white{background:white;color:var(--blue)}
.btn-red{background:#d63c57}
.btn-gray{background:#e8eef7;color:var(--navy)}
.features{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
  margin-top:-37px;
  position:relative;
}
.feature{
  background:white;
  border-radius:19px;
  min-height:110px;
  box-shadow:0 10px 25px #183b6310;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  gap:9px;
  text-align:center;
  font-size:14px;
  color:#617592;
  font-weight:700;
}
.feature span{font-size:30px}
section{padding:75px 0;scroll-margin-top:110px}
h2{
  color:var(--navy);
  font-size:30px;
  margin:0 0 12px;
}
.section-subtitle{color:#7889a1;margin-bottom:30px}
.about{background:white}
.about-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:45px;
  align-items:center;
}
.about-art{
  min-height:320px;
  border-radius:28px;
  background:linear-gradient(135deg,#d8eaff,#c8f5ec);
  display:grid;
  place-items:center;
  font-size:105px;
}
.about p{line-height:2;color:#61738b}
.grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:23px;
}
.card{
  background:white;
  border:1px solid #e7edf7;
  border-radius:19px;
  overflow:hidden;
  box-shadow:0 5px 25px #1a3a6110;
}
.card-image{
  height:170px;
  background:linear-gradient(135deg,#e3efff,#d3f6ee);
  display:grid;
  place-items:center;
  font-size:65px;
}
.card-body{padding:23px}
.card h3{color:var(--navy);line-height:1.5}
.card p{color:#6d7e95;line-height:1.85}
.tag{
  display:inline-block;
  padding:5px 12px;
  background:#e7f1ff;
  color:var(--blue);
  border-radius:30px;
  font-size:12px;
  font-weight:700;
}
.date{color:#8a9ab0;font-size:12px}
.search{
  width:100%;
  max-width:420px;
  padding:13px 16px;
  border:1px solid #d8e3f1;
  border-radius:12px;
  margin-bottom:25px;
  background:white;
}
.alt-section{background:#eef5ff}
.contact{background:#e9f2ff}
.admin-box{
  background:white;
  border:1px solid #dfe8f5;
  border-radius:20px;
  padding:27px;
}
.warning{
  background:#fff5dc;
  color:#77531d;
  padding:15px;
  border-radius:12px;
  margin-bottom:25px;
  line-height:1.8;
}
.admin-box label{font-weight:700}
.admin-box input,.admin-box textarea{
  width:100%;
  border:1px solid #d7e2f0;
  border-radius:11px;
  padding:13px;
  margin:8px 0 17px;
}
.admin-box textarea{min-height:115px}
.admin-row{
  padding:15px 0;
  border-bottom:1px solid #e7edf6;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
}
.admin-actions{display:flex;gap:8px}
.admin-actions button{padding:8px 12px;font-size:13px}
footer{
  background:var(--navy);
  color:white;
  text-align:center;
  padding:38px 20px;
}
footer p{color:#c1d2e9}
@media(max-width:800px){
  .hero-grid,.about-grid{grid-template-columns:1fr}
  .grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .navbar{padding:15px 0}
}
@media(max-width:550px){
  .grid,.features{grid-template-columns:1fr}
  .features{margin-top:20px}
  .hero{padding:55px 0}
  section{padding:50px 0}
  .admin-row{flex-direction:column;align-items:flex-start}
}
</style>
</head>
